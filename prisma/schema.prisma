// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACTOR
}

enum WorkLogStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model Organization {
  id        String   @id @default(cuid())
  name      String

  users     User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shiftTemplates ShiftTemplate[]
}

model User {
  id              String           @id @default(cuid())

  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])

  email           String           @unique
  passwordHash    String

  firstName       String
  lastName        String

  role            UserRole         @default(EMPLOYEE)
  employmentType  EmploymentType   @default(FULL_TIME)

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId])

  workLogs WorkLog[]
}

model ShiftTemplate {
  id                    String @id @default(cuid())

  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])

  name                  String

  plannedStartHour      Int
  plannedStartMinute    Int

  plannedEndHour        Int
  plannedEndMinute      Int

  defaultBreakMinutes   Int

  isNightShift          Boolean @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  workLogs              WorkLog[]

  @@index([organizationId])
}

model WorkLog {
  id                String @id @default(cuid())

  userId            String
  user              User @relation(fields: [userId], references: [id])

  shiftTemplateId   String?
  shiftTemplate     ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])

  workDate          DateTime

  startedAt         DateTime
  endedAt           DateTime

  notes             String?

  status            WorkLogStatus @default(DRAFT)

  approvedById      String?
  approvedAt        DateTime?

  breakEntries      BreakEntry[]

  workSummary       WorkSummary?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([workDate])
}

model BreakEntry {
  id              String @id @default(cuid())

  workLogId       String
  workLog         WorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)

  startedAt       DateTime
  endedAt         DateTime

  isPaid          Boolean @default(false)

  createdAt       DateTime @default(now())
}

model WorkSummary {
  id                     String @id @default(cuid())

  workLogId              String @unique
  workLog                WorkLog @relation(fields: [workLogId], references: [id], onDelete: Cascade)

  regularMinutes         Int

  overtimeMinutes        Int
  doubleOvertimeMinutes  Int

  nightMinutes           Int

  unpaidBreakMinutes     Int

  calculatedAt           DateTime @default(now())
}